// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum VariantType {
  COLOR
  SIZE
  FEATURE
}

enum LandingPageStatus {
  PUBLISHED
  DRAFT
}

enum TemplateSectionType {
  HERO
  FEATURES
  TESTIMONIALS
  CTA
  TEXT
  IMAGE
  GALLERY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  cart     Cart?
  wishlist Wishlist[]
}

model Product {
  id            String        @id @default(cuid())
  name          String
  description   String
  price         Float
  originalPrice Float
  category      String
  stock         Int
  status        ProductStatus @default(ACTIVE)
  rating        Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  landingPages  LandingPage[]
  orderItems    OrderItem[]
  wishlistItems Wishlist[]
  CartItem      CartItem[]
}

model ProductImage {
  id        String          @id @default(cuid())
  url       String
  alt       String
  isPrimary Boolean         @default(false)
  product   Product         @relation(fields: [productId], references: [id])
  productId String
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?
}

model ProductVariant {
  id            String      @id @default(cuid())
  name          String
  type          VariantType
  value         String
  description   String?
  priceModifier Float?
  stockQuantity Int
  product       Product     @relation(fields: [productId], references: [id])
  productId     String

  images     ProductImage[]
  orderItems OrderItem[]
  cartItems  CartItem[]
}

model Order {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  customerName    String
  customerEmail   String
  total           Float
  status          OrderStatus @default(PENDING)
  shippingAddress String
  orderDate       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id          String          @id @default(cuid())
  order       Order           @relation(fields: [orderId], references: [id])
  orderId     String
  product     Product         @relation(fields: [productId], references: [id])
  productId   String
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantId   String?
  quantity    Int
  price       Float
  productName String
}

model LandingPageTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections TemplateSection[]
  pages    LandingPage[]
}

model TemplateSection {
  id         String              @id @default(cuid())
  template   LandingPageTemplate @relation(fields: [templateId], references: [id])
  templateId String
  type       TemplateSectionType
  title      String?
  content    String?
  image      String?
  settings   Json?
  order      Int
}

model LandingPage {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  product     Product             @relation(fields: [productId], references: [id])
  productId   String
  template    LandingPageTemplate @relation(fields: [templateId], references: [id])
  templateId  String
  headline    String?
  subheadline String?
  description String?
  heroImage   String?
  status      LandingPageStatus   @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sections LandingPageSection[]
}

model LandingPageSection {
  id            String              @id @default(cuid())
  landingPage   LandingPage         @relation(fields: [landingPageId], references: [id])
  landingPageId String
  type          TemplateSectionType
  title         String?
  content       String?
  image         String?
  settings      Json?
  order         Int
}

model Cart {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cart      Cart            @relation(fields: [cartId], references: [id])
  cartId    String
  product   Product         @relation(fields: [productId], references: [id])
  productId String
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?
  quantity  Int
}

model Wishlist {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}
